{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python-envs.defaultPackageManager": "ms-python.python:pip",
    "python.analysis.exclude": [
        "**/.cache",
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/.ruff_cache",
        "**/.venv",
        "**/build",
        "**/dist",
        "**/node_modules",
        "**/site"
    ],
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/site/**": true,
        "**/dist/**": true,
        "**/.mypy_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/__pycache__/**": true,
        "**/.cache/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/site": true,
        "**/dist": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/uv.lock": true,
        "**/.cache": true,
        "**/typings": true
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.pytest_cache": true,
        "**/.DS_Store": true
    },
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:venv",
            "packageManager": ""
        }
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.indexing": true,
    "git.autorefresh": true
}
